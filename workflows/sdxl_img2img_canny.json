{
  "_comment": "ComfyUI API-format workflow. Tokens like __PROMPT__, __DENOISE__, __SEED__, __INPUT_IMAGE__, __PREV_STYLIZED__, __PREV_BLEND__ are substituted by pipeline/stylize.py at runtime. Adjust ckpt_name and control_net_name to match your installation.",

  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CKPT__" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEG_PROMPT__", "clip": ["1", 1] }
  },

  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "__INPUT_IMAGE__" }
  },
  "11": {
    "class_type": "LoadImage",
    "_optional_prev": true,
    "inputs": { "image": "__PREV_STYLIZED__" }
  },

  "20": {
    "class_type": "Canny",
    "inputs": {
      "image": ["10", 0],
      "low_threshold": "__CANNY_LOW__",
      "high_threshold": "__CANNY_HIGH__"
    }
  },
  "21": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "__CONTROLNET__" }
  },
  "22": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["21", 0],
      "image": ["20", 0],
      "strength": "__CN_STRENGTH__",
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },

  "30": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["10", 0], "vae": ["1", 2] }
  },
  "31": {
    "class_type": "VAEEncode",
    "_optional_prev": true,
    "inputs": { "pixels": ["11", 0], "vae": ["1", 2] }
  },
  "32": {
    "class_type": "LatentBlend",
    "_optional_prev": true,
    "inputs": {
      "samples1": ["30", 0],
      "samples2": ["31", 0],
      "blend_factor": "__PREV_BLEND__"
    }
  },

  "40": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["22", 0],
      "negative": ["22", 1],
      "latent_image": ["__INIT_LATENT_NODE__", 0],
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "__SAMPLER__",
      "scheduler": "__SCHEDULER__",
      "denoise": "__DENOISE__"
    }
  },
  "41": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["40", 0], "vae": ["1", 2] }
  },
  "42": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["41", 0],
      "filename_prefix": "__OUT_PREFIX__"
    }
  }
}
